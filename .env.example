# Copy this file to .env.local and fill in real values (Supabase project
# Settings > API). Never commit .env.local or paste the service role key
# anywhere public — it has full read/write access to the database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: gate the whole site behind a single shared HTTP Basic Auth
# password (any username works) until real per-user login exists. Leave
# unset to keep the site open to anyone with the URL.
APP_PASSWORD=
