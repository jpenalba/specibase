# Copy this file to .env.local and fill in real values (Supabase project
# Settings > API). Never commit .env.local or paste the service role key
# anywhere public — it has full read/write access to the database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Real per-user login (see AUTH_AND_PERMISSIONS_PLAN.md, Phase 1). Same
# project, so NEXT_PUBLIC_SUPABASE_URL is the same value as SUPABASE_URL
# above — the NEXT_PUBLIC_SUPABASE_ANON_KEY is a different key, the
# project's "anon" / "publishable" key from that same Settings > API page.
# These are safe to expose to the browser: the anon key only grants what
# Row Level Security allows, which today is nothing on every table, so
# this pair is for identity (who's signed in) only, never for reading or
# writing application data.
#
# Leave both unset to keep the site open with no login required, the same
# as today — until they're set, nothing is gated. Once set, run
# supabase/migrations/0031_profiles.sql (if you haven't already) and
# create your own first account from the Supabase dashboard under
# Authentication > Users > Add user (there's no self-service sign-up).
#
# Also add <your-site-url>/reset-password to Authentication > URL
# Configuration > Redirect URLs in the same dashboard — "Forgot password?"
# on /login, "Change password" in the account menu's User settings, and
# every invite email (the account-menu "Invite other users" and a
# project's own "Add member") all send a link there, and Supabase silently
# drops the redirect if it isn't on that allow list. While there, also
# check Authentication > URL Configuration > Site URL itself is set to
# your real deployed URL (e.g. https://specibase.vercel.app), not
# localhost — an invite's email template falls back to it if anything
# about the redirect is misconfigured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
